{
  "name": "omni-autogpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --ip 0.0.0.0 --port 8787",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "deploy": "node scripts/check-deploy.mjs && npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply omni --local",
    "db:remote": "wrangler d1 migrations apply omni --remote",
    "test:browser": "playwright test",
    "format": "prettier --write --ignore-unknown .",
    "check": "prettier --check --ignore-unknown ."
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "undici": "8.12.3",
    "sharp": "0.35.5"
  }
}
